# Copy to .env.local and fill in. Never commit .env.local.
# Values: Supabase dashboard -> Project Settings -> API Keys (URL under Data API).

# Public: safe in the browser. RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The "anon" legacy key, or the new "publishable" key (sb_publishable_...).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET: server only, bypasses RLS. Never prefix with NEXT_PUBLIC_.
# The "service_role" legacy key, or the new "secret" key (sb_secret_...).
SUPABASE_SERVICE_ROLE_KEY=

# Public origin of the site, used in WhatsApp messages and metadata.
# Optional on Vercel (falls back to the production domain).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
